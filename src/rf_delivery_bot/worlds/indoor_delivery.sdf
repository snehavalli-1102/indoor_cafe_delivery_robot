<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="restaurant">

    <!-- ============================================================
         Physics Engine Configuration (ODE / Dantzig Solver)
    ============================================================ -->
    <physics name="default_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Fortress Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scene Environment -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.82 0.85 0.88 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>35 35</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>35 35</size></plane></geometry>
          <material>
            <diffuse>0.82 0.80 0.74 1.0</diffuse>
            <specular>0.08 0.08 0.08 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         RESTAURANT PERIMETER WALLS
         Size: 8.0m wide (x: -4.2 to +3.8), 18.0m long (y: -9.0 to +9.0)
    ============================================================ -->
    <model name="wall_north">
      <static>true</static>
      <pose>-0.2 9.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.20 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.20 2.5</size></box></geometry>
          <material><diffuse>0.86 0.84 0.82 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>-0.2 -9.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.2 0.20 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.2 0.20 2.5</size></box></geometry>
          <material><diffuse>0.86 0.84 0.82 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.8 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 18.2 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 18.2 2.5</size></box></geometry>
          <material><diffuse>0.86 0.84 0.82 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.2 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 18.2 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 18.2 2.5</size></box></geometry>
          <material><diffuse>0.86 0.84 0.82 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         SERVICE CORRIDOR PARTITIONS & KITCHEN COUNTER
    ============================================================ -->
    <model name="partition_left">
      <static>true</static>
      <pose>-2.2 4.75 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 7.5 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 7.5 2.0</size></box></geometry>
          <material><diffuse>0.78 0.76 0.74 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_right">
      <static>true</static>
      <pose>-2.2 -4.75 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 7.5 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 7.5 2.0</size></box></geometry>
          <material><diffuse>0.78 0.76 0.74 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="kitchen_counter">
      <static>true</static>
      <pose>-3.2 2.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 4.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 4.0 0.9</size></box></geometry>
          <material><diffuse>0.72 0.74 0.76 1.0</diffuse><specular>0.4 0.4 0.4 1.0</specular></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         FRONT SECTION: TABLE 1 & TABLE 2 WITH INDIVIDUAL LEGS & CHAIRS
    ============================================================ -->
    <!-- Table 1 (x = -0.8, y = -4.0) -->
    <model name="table1_top">
      <static>true</static>
      <pose>-0.8 -4.0 0.72 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.65</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.65</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.68 0.46 0.26 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table1_leg">
      <static>true</static>
      <pose>-0.8 -4.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry>
          <material><diffuse>0.18 0.18 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Table 1 North Chair -->
    <model name="table1_chair_n_seat"><static>true</static><pose>-0.8 -3.15 0.23 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.42 0.46</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.42 0.46</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <model name="table1_chair_n_back"><static>true</static><pose>-0.8 -2.95 0.65 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.05 0.42</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.05 0.42</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <!-- Table 1 South Chair -->
    <model name="table1_chair_s_seat"><static>true</static><pose>-0.8 -4.85 0.23 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.42 0.46</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.42 0.46</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <model name="table1_chair_s_back"><static>true</static><pose>-0.8 -5.05 0.65 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.05 0.42</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.05 0.42</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>

    <!-- Table 2 (x = 1.8, y = -4.0) -->
    <model name="table2_top">
      <static>true</static>
      <pose>1.8 -4.0 0.72 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.65</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.65</radius><length>0.04</length></cylinder></geometry>
          <material><diffuse>0.68 0.46 0.26 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table2_leg">
      <static>true</static>
      <pose>1.8 -4.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry>
          <material><diffuse>0.18 0.18 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Table 2 North Chair -->
    <model name="table2_chair_n_seat"><static>true</static><pose>1.8 -3.15 0.23 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.42 0.46</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.42 0.46</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <model name="table2_chair_n_back"><static>true</static><pose>1.8 -2.95 0.65 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.05 0.42</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.05 0.42</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <!-- Table 2 South Chair -->
    <model name="table2_chair_s_seat"><static>true</static><pose>1.8 -4.85 0.23 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.42 0.46</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.42 0.46</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>
    <model name="table2_chair_s_back"><static>true</static><pose>1.8 -5.05 0.65 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.42 0.05 0.42</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.42 0.05 0.42</size></box></geometry><material><diffuse>0.48 0.30 0.16 1.0</diffuse></material></visual>
    </link></model>

    <!-- ============================================================
         BACK SECTION: TABLE 3 & TABLE 4 WITH SEATED CUSTOMERS
    ============================================================ -->
    <!-- Table 3 (x = -0.8, y = 5.0) -->
    <model name="table3_top"><static>true</static><pose>-0.8 5.0 0.72 0 0 0</pose><link name="link">
      <collision name="col"><geometry><cylinder><radius>0.60</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.60</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.68 0.46 0.26 1.0</diffuse></material></visual>
    </link></model>
    <model name="table3_leg"><static>true</static><pose>-0.8 5.0 0.35 0 0 0</pose><link name="link">
      <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry><material><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
    </link></model>
    <model name="customer_seated_1"><static>true</static><pose>-0.8 5.8 0.65 0 0 -1.57</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.24</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="torso"><geometry><cylinder><radius>0.24</radius><length>0.8</length></cylinder></geometry><material><diffuse>0.18 0.42 0.82 1.0</diffuse></material></visual>
      <visual name="head"><pose>0 0 0.55 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><diffuse>0.85 0.70 0.55 1.0</diffuse></material></visual>
    </link></model>

    <!-- Table 4 (x = 1.8, y = 5.0) -->
    <model name="table4_top"><static>true</static><pose>1.8 5.0 0.72 0 0 0</pose><link name="link">
      <collision name="col"><geometry><cylinder><radius>0.60</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.60</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.68 0.46 0.26 1.0</diffuse></material></visual>
    </link></model>
    <model name="table4_leg"><static>true</static><pose>1.8 5.0 0.35 0 0 0</pose><link name="link">
      <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.12</radius><length>0.70</length></cylinder></geometry><material><diffuse>0.18 0.18 0.18 1.0</diffuse></material></visual>
    </link></model>
    <model name="customer_seated_2"><static>true</static><pose>1.8 5.8 0.65 0 0 -1.57</pose><link name="link">
      <collision name="c"><geometry><cylinder><radius>0.24</radius><length>1.0</length></cylinder></geometry></collision>
      <visual name="torso"><geometry><cylinder><radius>0.24</radius><length>0.8</length></cylinder></geometry><material><diffuse>0.18 0.42 0.82 1.0</diffuse></material></visual>
      <visual name="head"><pose>0 0 0.55 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><diffuse>0.85 0.70 0.55 1.0</diffuse></material></visual>
    </link></model>

    <!-- ============================================================
         WALKING 3D HUMAN PEDESTRIAN OBSTACLE IN MAIN AISLE
    ============================================================ -->
    <model name="human_pedestrian_aisle">
      <static>false</static>
      <pose>0.5 1.2 0.85 0 0 0</pose>
      <link name="link">
        <inertial><mass>75.0</mass><inertia><ixx>10.0</ixx><iyy>10.0</iyy><izz>2.0</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="torso"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><diffuse>0.82 0.22 0.22 1.0</diffuse></material> <!-- Formal Red Jacket -->
        </visual>
        <visual name="head"><pose>0 0 0.8 0 0 0</pose><geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material><diffuse>0.86 0.72 0.58 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         DELIVERY ROBOT SPAWN (Center Aisle, facing North)
    ============================================================ -->
    <include>
      <name>delivery_robot</name>
      <uri>model://turtlebot3_burger</uri>
      <pose>0.5 -1.2 0.05 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
